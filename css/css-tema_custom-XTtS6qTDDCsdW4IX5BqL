.treeCover {
position: absolute;
inset: 0;
z-index: 3;
}

.treeCover .orn-1{
position: absolute;
top: 0;
left: -20%;
animation-name: slidetoLeft;
animation-duration: 2s;
}

.treeCover .orn-2{
position: absolute;
top: 0;
right: -20%;
animation-name: slidetoRight;
animation-duration: 2s;
}

@keyframes slidetoLeft {
  from {

left: -20%;
transform: scale(.8) rotate(30deg);
}
  to {
top: -15%;
left: -40%;
transform: scale(.8) rotate(0deg);
  }
}

@keyframes slidetoRight {
  from {
transform: scale(.8) rotate(-30deg);

right:-20%;
}
  to {
transform: scale(.8) rotate(0deg);
top: -15%;
right: -40%;
  }
}

